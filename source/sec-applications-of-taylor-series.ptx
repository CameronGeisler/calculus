<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-applications-of-taylor-series" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Applications of Taylor Series</title>
  
  <!-- <introduction>
  <p>
  This is the introduction to the section. It can contain any content
  that is valid in a <introduction> element, including <p>, <ul>, <ol>,
