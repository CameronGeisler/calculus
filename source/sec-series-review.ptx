<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-series-review" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Series Review</title>

  <introduction>
    <p>
      The three main question types for series (and sequences) problems are:
        <ul>
            <li>
                Find the limit of the sequence, or determine if the sequence diverges.
            </li>
            <li>
                Determine if series converges or diverges.
            </li>
            <li>
                Find the value of the sum of the series, or determine if it diverges.
            </li>
            <li>
                Determine if series converges absolutely, converges conditionally, or diverges.
            </li>
        </ul>
    </p>
  </introduction>

  <subsection>
    <title>Exercises</title>
    <exercises>
        <exercisegroup>
        <title>Limit of sequences</title>
        <introduction>
        <p>Find the limit of each sequence, or determine if the sequence diverges.</p>
        </introduction>

        <exercise>
        <statement><p><m>\set{\frac{n^3}{n^4+1}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{n^{12}}{3n^{12}+4}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{3n^3-1}{2n^3+1}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{n^5+3n}{10n^3+n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\tan^{-1}\brac{\frac{10n}{10n+4}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{1+\cos\brac{\frac{1}{n}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\ln\brac{n^3+1}-\ln\brac{3n^3+10n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\ln\brac{\sin\brac{\frac{1}{n}}}+\ln n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{n}{\sqrt{9n^2+1}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{\sqrt{4n^4+3n}}{8n^2+1}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{2e^n+1}{e^n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{\ln(n^2)}{\ln(3n)}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{5(-1.01)^n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{2^n+3^{-n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{100(-0.003)^n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{(0.5)^n+3(0.75)^n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{e^n+\pi^n}{e^n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{3^{n+1}+3}{3^n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{3^n}{3^n+4^n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{(n+1)!}{n!}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{(2n)! \cdot n^2}{(2n+2)!}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\tan^{-1} n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{e^{n/10}}{2^n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\sqrt{n^2+1}-n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{n^2}{n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\brac{1+\frac{2}{n}}^n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{\ln n}{n^{1.1}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\sqrt[n]{e^{3n+4}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\brac{\frac{n}{n+5}}^n}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\sqrt{\brac{1+\frac{1}{2n}}^n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\brac{1+\frac{4}{n}}^{3n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{n}{e^n+3n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{\ln\brac{\frac{1}{n}}}{n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\brac{\frac{1}{n}}^{1/n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\brac{1-\frac{4}{n}}^n}</m></p></statement>
        </exercise>

        <exercise>
        <statement>
            <p>
            <m>
                \set{b_n}, \quad b_n=\begin{cases}
                \frac{n}{n+1}, \amp n \leq 5000 \\
                ne^{-n}, \amp n \gt 5000
                \end{cases}
            </m>
            </p>
        </statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\cot\brac{\frac{n\pi}{2n+2}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{n\brac{1-\cos\frac{1}{n}}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{n\sin\frac{6}{n}}</m></p></statement>
        </exercise>

        <exercise>
        <statement><p><m>\set{\frac{n^8+n^7}{n^7+n^8\ln n}}</m></p></statement>
        </exercise>

        </exercisegroup>

        <exercisegroup>
        <title>Convergence of series</title>
        <introduction>
        <p>Determine if each series converges or diverges.</p>
        </introduction>

        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n^2-1}{n^3+1}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{1}{n\sqrt{\ln n}}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{1}{n^3}+\frac{1}{3^n}}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{3^n n^2}{n!}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{\sin(2n)}{1+2^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n^{2n}}{(1+n)^{3n}}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n^{\sqrt{2}}}{2^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{2^{n-1} 3^{n+1}}{n^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{\sqrt{n^4+1}}{n^3+n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{1\cdot 3\cdot 5\cdots (2n-1)}{2\cdot 5\cdot 8\cdots (3n-1)}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{\sqrt[3]{n}-1}{\,n\brac{\sqrt{n}+1}}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{1}{n \cdot 3^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{2n+3}{5n+4}}^n</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{1}{\ln n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{(\ln n)^2}{n^3}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n!}{10^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n^{10}}{10^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{n-2}{n}}^n</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{2+(-1)^n}{1.25^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{-2}{3}}^n</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{1-\frac{1}{3n}}^n</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{\ln n}{n^3}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{(-\ln n)^n}{n^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{1}{n}-\frac{1}{n^2}}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{e^n}{n^e}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n\ln n}{(-2)^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(n+1)(n+2)}{n!}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} e^{-n^3}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(n+3)!}{3!\,n!\,3^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n\,2^n\,(n+1)!}{3^n n!}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n!}{(2n+1)!}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} n^2 e^{-2n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n!}{(-n)^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{1}{n(\ln n)^2}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=3}^{\infty} \frac{\ln n}{\ln(\ln n)}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{n+1}{n!}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{1}{n}-\frac{1}{n^2}}^n</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{2^n 3^n}{n^n}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{1}{\sqrt{n(n+1)(n+2)}}</m></p></statement></exercise>
        <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{1}{n\sqrt{n^2-1}}</m></p></statement></exercise>
        </exercisegroup>

        <exercisegroup>
            <title>Sum of a series</title>
            <introduction>
            <p>Find the value of the sum of each series, or determine if it diverges. Simplify your answer completely.</p>
            </introduction>

            <exercise><statement><p><m>\sum_{n=3}^{\infty} \frac{1}{(2n-3)(2n-1)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} 3\,(1.001)^n</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=2}^{\infty} \frac{-2}{n(n+1)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\frac{9}{10}}^n</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{9}{(3n-1)(3n+2)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=0}^{\infty} \brac{\frac{1}{3}}^n + \brac{\frac{4}{3}}^n</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{1}{n(n+3)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{3^n-5^n}{10^n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=3}^{\infty} \frac{-8}{(4n-3)(4n+1)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \ln\!\brac{\frac{2n+1}{2n-1}}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=0}^{\infty} e^{-n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=0}^{\infty} \brac{-\frac{1}{5}}^n</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^n \frac{3}{4^n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \brac{\tan^{-1}(n+1)-\tan^{-1}n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=2}^{\infty} \brac{\frac{1}{\sqrt{n}}-\frac{1}{\sqrt{n-1}}}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=2}^{\infty} \brac{\frac{2^{n+1}}{3^n} + \frac{1}{2n-1} - \frac{1}{2n+1}}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{9}{(3n-2)(3n+1)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} 4^{-3n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{2^n}{3^{n+2}}</m></p></statement></exercise>
        </exercisegroup>

        <exercisegroup>
            <title>Absolute convergence and conditional convergence</title>
            <introduction>
            <p>Determine if each series converges absolutely, converges conditionally, or diverges.</p>
            </introduction>

            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(-1)^{n+1} n^2}{n^3+1}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(-1)^n 10^n}{(n+1)!}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-5)^{-n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^n \frac{n^2-1}{n^3+1}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} n!(-e)^{-n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^n \frac{n^2-1}{n^2+1}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^{n-1}\frac{n^4}{4^n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^{n+1}\left(\frac{n}{10}\right)^n</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(-1)^n}{\ln(n+1)}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(-1)^n}{n\sqrt{n^2+1}}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(-1)^n 3n^2}{n^3+1}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} \frac{(-1)^n (n^2+1)}{2n^2+n-1}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^n n^2 e^{-n}</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=1}^{\infty} (-1)^n \brac{1-\frac{3}{n}}^n</m></p></statement></exercise>
            <exercise><statement><p><m>\sum_{n=2}^{\infty} (-1)^{n-1}\frac{1}{\sqrt{n}-1}</m></p></statement></exercise>
        </exercisegroup>
    </exercises>

  </subsection>

</section>